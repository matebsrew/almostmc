# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Zernio API, AI Gateway, and webhook signing secrets are set per-workspace in Settings.
# For self-hosted, you can optionally set AI_GATEWAY_API_KEY as a fallback.

# AI Gateway (for AI Response flow node, optional for self-hosted)
# On Vercel: configure provider keys in AI Gateway settings (automatic OIDC auth)
# Self-hosted: set this key from https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=your-gateway-key

# Generate a unique random bearer secret with at least 32 characters.
CRON_SECRET=replace-with-at-least-32-random-characters

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
